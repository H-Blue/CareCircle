# Server only. Never add Oracle keys to the iPhone app or commit this file's real values.
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
# Use the model OCID from Oracle's playground > View code.
OCI_MODEL_ID=
OCI_CHAT_FORMAT=COHERE
# Generate a random token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ENCIRCLE_APP_TOKEN=
# Default is localhost. Set to your Mac's LAN address only for local device development.
ENCIRCLE_HOST=127.0.0.1
ENCIRCLE_PORT=8787

# ElevenLabs private agent. Server only; never put this key in the app.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional persistent coordinator. Provision private storage with Cloud/deploy.py.
COORDINATOR_NAMESPACE=
COORDINATOR_BUCKET=
ENCIRCLE_PUBLIC_URL=
# Existing Twilio credential stays on the server, never in the iPhone app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER_SID=
# One authorized E.164 demo destination; never expand without its owner's consent.
TWILIO_ALLOWED_NUMBERS=
TWILIO_SMS_APPROVED=0
TWILIO_AUTO_ENABLE_DEMO=0

# Phone sign-in and circle membership; private Oracle NoSQL table OCID + Twilio Verify service SID.
ENCIRCLE_USERS_TABLE=
TWILIO_VERIFY_SERVICE_SID=

# Allow user-requested US/Canada sign-in codes; trial recipient limits still apply.
TWILIO_VERIFY_SELF_SERVICE=0
